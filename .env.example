# Razorpay (passed via --dart-define=RAZORPAY_KEY=...)
RAZORPAY_KEY=rzp_test_XXXXXXXXXX

# Firebase (handled by firebase_options.dart, no env needed)

# API
API_BASE_URL=https://asia-south1-housepital-patient.cloudfunctions.net/api

# AI Assistant (Sahayak) Cloud Function URL.
# OPTIONAL — omit to use the offline Hinglish keyword stub.
# When set (via --dart-define=ASSISTANT_API_URL=...), the assistant is powered
# by the deployed Claude Cloud Function. See functions/README.md.
ASSISTANT_API_URL=https://asia-south1-housepital-patient.cloudfunctions.net/assistant

# NOTE: ANTHROPIC_API_KEY is NOT a client value. It is a server-side Firebase
# secret on the assistant function:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# It never ships in the app binary. See functions/README.md.
